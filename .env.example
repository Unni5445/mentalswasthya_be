NODE_ENV=development
PORT=5000
API_KEY=your_server_api_key_here
MONGO_URI=mongodb://localhost:27017/healthbbreath

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Token secrets
JWT_SECRET_INDIVIDUAL=change_me_individual_access_secret
JWT_REFRESH_SECRET_INDIVIDUAL=change_me_individual_refresh_secret
JWT_SECRET_CORPORATE=change_me_corporate_access_secret
JWT_REFRESH_SECRET_CORPORATE=change_me_corporate_refresh_secret

# Token expiry
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mailer
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password
